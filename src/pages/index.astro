---
import Links from "../components/Links.astro";
import Authors from "../components/Authors.astro";
import Notes from "../components/Notes.astro";
import type { Author, Affiliation, Note, Link } from "../types/types";

import Table from "../components/Table.astro";

import "../styles/global.css";
import "katex/dist/katex-swap.css";

import { Content, frontmatter } from "../paper.mdx";

interface Frontmatter {
  title: string;
  authors: Author[];
  affiliations?: Affiliation[];
  conference?: string;
  notes?: Note[];
  links?: Link[];
  description?: string;
  favicon: string;
  thumbnail?: string;
  theme?: "device" | "light" | "dark";
}

const {
  title,
  authors,
  affiliations,
  conference,
  notes,
  links,
  description,
  favicon,
  thumbnail,
  theme = "device",
} = frontmatter as Frontmatter;

const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";
const [titleLead, ...titleTailParts] = title.split(" via ");
const titleTail = titleTailParts.join(" via ");
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    {description && <meta name="description" content={description} />}
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href={prefix + favicon} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {thumbnail && <meta property="og:image" content={prefix + thumbnail} />}

    <title>{title}</title>
  </head>
  <body
    class="site-shell prose prose-lg prose-zinc dark:prose-invert prose-a:no-underline prose-a:hover:underline prose-a:font-normal prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-medium prose-code:before:content-none prose-code:after:content-none max-w-none"
  >
    <header class="hero mx-auto mb-14 max-w-[74rem] px-6 text-center">
      <p class="hero-eyebrow">Real2Sim2Real Tactile Policy Learning</p>
      <h1 class="project-title">
        <span>{titleLead}</span>
        {titleTail && <span>via {titleTail}</span>}
      </h1>
      <div class="mb-8 flex flex-col items-center gap-6">
        {(authors?.length ?? 0) > 0 && (
          <Authors authors={authors} affiliations={affiliations} />
        )}
        {conference && <div class="conference-pill">{conference}</div>}
        {notes && <Notes notes={notes} />}
        {links && <Links links={links} />}
      </div>
      <p class="hero-subtitle">
        A tactile-only dexterous grasping policy for a sensorized LEAP Hand:
        calibrated contact simulation, geometry-aware tactile representation,
        and diffusion-based policy distillation.
      </p>
      <div class="hero-stats not-prose" aria-label="Project highlights">
        <div><strong>44</strong><span>tactile channels</span></div>
        <div><strong>20</strong><span>real objects</span></div>
        <div><strong>0</strong><span>visual input</span></div>
      </div>
    </header>
    <main>
      <Content components={{ table: Table }} />
    </main>
    <footer class="mx-auto max-w-[50rem] px-6 text-center">
      <p class="prose-sm text-center"></p>
    </footer>
  </body>
</html>
