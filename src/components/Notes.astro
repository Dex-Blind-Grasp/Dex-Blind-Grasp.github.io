---
import type { Note } from "../types/types";

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
---

<div
  class="not-prose flex flex-wrap justify-center gap-x-4 gap-y-1 text-center text-sm"
>
  {
    notes.map((note) => (
      <span class="whitespace-nowrap">
        <sup class="mr-1">{note.symbol}</sup>
        {note.text}
      </span>
    ))
  }
</div>
